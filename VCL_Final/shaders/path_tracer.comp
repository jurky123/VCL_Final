#version 430 core
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 3) uniform sampler2DArray u_texArray;

layout(rgba32f, binding = 0) uniform image2D u_output_tex;
#define PI 3.141592653
/* ===================== 数据结构 ===================== */
struct GPU_Material {
    vec4 diffuse;     // xyz = color
    vec4 specular;    // xyz = specular

    float emission;
    float metallic;
    float shiness;
    int diffuseTexID;
};

layout(std430, binding = 2) buffer MaterialBuffer {
    GPU_Material materials[];
};

// GPU 光源结构（std430 对齐安全，使用 vec4 保证对齐）
struct GPU_Light {
    int type; //0 = Point,1 = Directional
    int pad0;
    int pad1;
    int pad2;
    vec4 position; // world space position (w unused)
    vec4 direction; // direction (w unused)
    vec4 intensity; // rgb = intensity, a unused
};

layout(std430, binding = 4) buffer LightBuffer {
    GPU_Light lights[];
};

struct Triangle {
    vec4 v0;
    vec4 v1;
    vec4 v2;

    vec4 n0;
    vec4 n1;
    vec4 n2;

    vec4 uv0;
    vec4 uv1;
    vec4 uv2;

    uint material_id;
    uint pad0, pad1, pad2;
};

layout(std430, binding = 1) buffer TriangleBuffer {
    Triangle triangles[];
};

// Sphere primitive
struct Sphere {
    vec4 pos; // xyz = center, w = radius
    vec4 emission; // rgb
    vec4 color; // rgb
    int type; //0=DIFF,1=SPEC,2=REFR
    float ior; // index of refraction
    int pad0;
    int pad1;
};
layout(std430, binding = 5) buffer SphereBuffer {
    Sphere spheres[];
};

/* ===================== Uniforms ===================== */
uniform mat4 u_inv_view;
uniform mat4 u_inv_proj;
uniform int  u_frame_index;
uniform int  u_triangle_count;
uniform int  u_sphere_count;
uniform int  u_samples_per_pixel;
uniform int  u_material_count; // 使用 CPU端上传的材质数量
uniform int  u_light_count; // 使用 CPU端上传的灯光数量
uniform int  u_max_bounces; // 最大反射/漫反射跳数

/* ===================== RNG ===================== */
uint seed;
uint nextRandom() {
    seed = seed * 747796405u + 2891336453u;
    uint word = ((seed >> ((seed >> 28u) + 4u)) ^ seed) * 277803737u;
    return (word >> 22u) ^ word;
}
float randomFloat() { return float(nextRandom()) / 4294967296.0; }

// cosine-weighted hemisphere sample
vec3 cosineSampleHemisphere(float u1, float u2) {
    float r = sqrt(u1);
    float theta = 2.0 * PI * u2;
    float x = r * cos(theta);
    float y = r * sin(theta);
    float z = sqrt(max(0.0, 1.0 - u1));
    return vec3(x, y, z);
}

vec3 makeOrthonormalBasis(vec3 n) {
    // placeholder not used
    return n;
}

/* ===================== Ray / Intersection ===================== */
struct Ray { vec3 origin; vec3 dir; };
struct HitPayload { float t; vec3 normal; int material_id; int hit_id; vec2 uv;};

HitPayload RayTriangleIntersect(Ray ray, uint idx) {
    HitPayload p;
    p.hit_id = -1;

    Triangle tri = triangles[idx];

    // ------------------ 传统 Möller–Trumbore ------------------
    vec3 v0v1 = tri.v1.xyz - tri.v0.xyz;
    vec3 v0v2 = tri.v2.xyz - tri.v0.xyz;

    vec3 pvec = cross(ray.dir, v0v2);
    float det = dot(v0v1, pvec);
    if (abs(det) < 1e-6) return p;

    float invDet = 1.0 / det;
    vec3 tvec = ray.origin - tri.v0.xyz;
    float u = dot(tvec, pvec) * invDet;
    if (u < 0.0 || u > 1.0) return p;

    vec3 qvec = cross(tvec, v0v1);
    float v = dot(ray.dir, qvec) * invDet;
    if (v < 0.0 || u + v > 1.0) return p;

    float t = dot(v0v2, qvec) * invDet;
    if (t < 0.001) return p;

    // ------------------ 填充 HitPayload ------------------
    p.t = t;
    p.normal = normalize(cross(v0v1, v0v2));
    if (det < 0.0) p.normal *= -1.0;
    p.material_id = int(tri.material_id);
    p.hit_id = int(idx);

    // ------------------ 透视校正 UV ------------------
    // 注意：tri.v*.w 是裁剪空间 w
    float w0 = (1.0 - u - v) / tri.v0.w;
    float w1 = u / tri.v1.w;
    float w2 = v / tri.v2.w;
    float sum = w0 + w1 + w2;
    p.uv = (w0 * tri.uv0.xy + w1 * tri.uv1.xy + w2 * tri.uv2.xy) / sum;

    return p;
}

HitPayload RaySphereIntersect(Ray ray, int idx) {
    HitPayload p;
    p.hit_id = -1;

    Sphere s = spheres[idx];
    vec3 center = s.pos.xyz;
    float radius = s.pos.w;
    vec3 oc = ray.origin - center;
    float b = dot(oc, ray.dir);
    float c = dot(oc, oc) - radius * radius;
    float det = b * b - c;
    if (det < 0.0) return p;
    det = sqrt(det);
    float t = -b - det;
    if (t < 0.001) t = -b + det;
    if (t < 0.001) return p;
    p.t = t;
    p.normal = normalize((ray.origin + ray.dir * t) - center);
    p.material_id = -1; // sphere marker
    p.hit_id = - (idx + 1);
    p.uv = vec2(0.0);
    return p;
}

HitPayload SceneIntersect(Ray ray) {
    HitPayload best; best.t = 1e20; best.hit_id = -1;
    for (int i = 0; i < u_sphere_count; ++i) {
        HitPayload p = RaySphereIntersect(ray, i);
        if (p.hit_id != -1 && p.t < best.t) best = p;
    }
    for (uint i = 0u; i < uint(u_triangle_count); ++i) {
        HitPayload p = RayTriangleIntersect(ray, i);
        if (p.hit_id != -1 && p.t < best.t) best = p;
    }
    return best;
}

/* ===================== Main Path Tracing (多跳) ===================== */
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(u_output_tex);
    if (any(greaterThanEqual(pixel, dims))) return;

    seed = uint(pixel.y * dims.x + pixel.x) + uint(u_frame_index) * 719393u;
    vec3 accumulated = vec3(0.0);

    for (int s = 0; s < u_samples_per_pixel; ++s) {
        vec2 jitter = vec2(randomFloat(), randomFloat());
        vec2 uv = (vec2(pixel) + jitter) / vec2(dims);
        vec4 target = u_inv_proj * vec4(uv * 2.0 - 1.0, 1.0, 1.0);

        Ray ray;
        ray.origin = (u_inv_view * vec4(0,0,0,1)).xyz;
        ray.dir = normalize((u_inv_view * vec4(target.xyz / target.w, 0)).xyz);

        vec3 throughput = vec3(1.0);
        vec3 radiance = vec3(0.0);

        // 路径追踪循环
        for (int bounce = 0; bounce <= u_max_bounces; ++bounce) {
            HitPayload hit = SceneIntersect(ray);
            if (hit.hit_id == -1) {
                // 没有击中，天空黑色(可扩展为环境色)
                break;
            }

            vec3 baseColor;
            vec3 normal;
            float emission = 0.0;
            int matType = 0; //0 diffuse,1 spec,2 refr
            float ior = 1.0;

            if (hit.hit_id < 0) {
                int sidx = -hit.hit_id - 1;
                Sphere S = spheres[sidx];
                baseColor = S.color.rgb;
                normal = hit.normal;
                emission = S.emission.r; // assume grayscale emission stored in r
                matType = S.type;
                ior = S.ior;
            } else {
                int mid = clamp(hit.material_id, 0, max(0, u_material_count - 1));
                GPU_Material mat = materials[mid];
                baseColor = (mat.diffuseTexID > 0) ? texture(u_texArray, vec3(hit.uv, float(mat.diffuseTexID - 1))).rgb : mat.diffuse.rgb;
                normal = normalize(hit.normal);
                emission = mat.emission;
                matType = (mat.metallic > 0.9) ? 1 : 0;
                ior = 1.5;
            }

            vec3 hitPos = ray.origin + ray.dir * hit.t;
            radiance += throughput * baseColor * emission;

            // 直接光照
            for (int li = 0; li < u_light_count; ++li) {
                GPU_Light L = lights[li];
                vec3 lightI = L.intensity.rgb;
                float NdotL = 0.0;
                float attenuation = 1.0;
                vec3 Ldir;
                bool occluded = false;

                if (L.type == 1) {
                    Ldir = normalize(-L.direction.xyz);
                    NdotL = max(dot(normal, Ldir), 0.0);
                    Ray shadowRay; shadowRay.origin = hitPos + Ldir * 1e-4; shadowRay.dir = Ldir;
                    HitPayload sh = SceneIntersect(shadowRay);
                    if (sh.hit_id != -1) occluded = true;
                } else {
                    vec3 toLight = L.position.xyz - hitPos;
                    float dist = length(toLight);
                    Ldir = normalize(toLight);
                    NdotL = max(dot(normal, Ldir), 0.0);
                    attenuation = 1.0 / (dist * dist + 1.0);
                    Ray shadowRay; shadowRay.origin = hitPos + Ldir * 1e-4; shadowRay.dir = Ldir;
                    HitPayload sh = SceneIntersect(shadowRay);
                    if (sh.hit_id != -1 && sh.t < dist - 1e-4) occluded = true;
                }
                if (!occluded && NdotL > 0.0) {
                    radiance += throughput * baseColor * lightI * NdotL * attenuation;
                }
            }

            // 若已到达最大 bounce，不再产生次级光线
            if (bounce == u_max_bounces) break;

            if (matType == 0) {
                // diffuse
                float r1 = randomFloat();
                float r2 = randomFloat();
                vec3 localDir = cosineSampleHemisphere(r1, r2);
                vec3 N = normalize(normal);
                vec3 tangent = normalize(abs(N.x) > 0.1 ? cross(vec3(0.0,1.0,0.0), N) : cross(vec3(1.0,0.0,0.0), N));
                vec3 bitangent = cross(N, tangent);
                vec3 newDir = normalize(localDir.x * tangent + localDir.y * bitangent + localDir.z * N);
                ray.origin = hitPos + newDir * 1e-4;
                ray.dir = newDir;
                throughput *= baseColor;
            } else if (matType == 1) {
                // mirror
                vec3 R = reflect(ray.dir, normalize(normal));
                ray.origin = hitPos + R * 1e-4;
                ray.dir = R;
                throughput *= baseColor;
            } else {
                // dielectric refraction (Schlick)
                vec3 N = normalize(normal);
                vec3 refl = reflect(ray.dir, N);
                bool into = dot(ray.dir, N) < 0.0;
                float nc = 1.0;
                float nt = ior;
                float nnt = into ? nc / nt : nt / nc;
                float ddn = dot(ray.dir, N);
                float cos2t = 1.0 - nnt*nnt * (1.0 - ddn*ddn);
                if (cos2t < 0.0) {
                    // total internal reflection
                    ray.origin = hitPos + refl * 1e-4;
                    ray.dir = refl;
                    throughput *= baseColor;
                } else {
                    vec3 tdir = normalize(ray.dir * nnt - N * ((into?1.0:-1.0)*(ddn*nnt + sqrt(cos2t))));
                    float R0 = pow((nt - nc) / (nt + nc),2.0);
                    float c = 1.0 - (into ? -ddn : dot(tdir, N));
                    float Re = R0 + (1.0 - R0) * pow(c,5.0);
                    float Tr = 1.0 - Re;
                    float P = 0.25 + 0.5 * Re;
                    if (randomFloat() < P) {
                        ray.origin = hitPos + refl * 1e-4;
                        ray.dir = refl;
                        throughput *= baseColor * (Re / P);
                    } else {
                        ray.origin = hitPos + tdir * 1e-4;
                        ray.dir = tdir;
                        throughput *= baseColor * (Tr / (1.0 - P));
                    }
                }
            }
        }

        accumulated += radiance;
    }

    vec3 color = accumulated / float(max(u_samples_per_pixel, 1));
    color = pow(color, vec3(1.0/2.2)); // gamma 校正
    imageStore(u_output_tex, pixel, vec4(color, 1.0));
}
